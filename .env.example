# ==============================================================================
# DreamzDecors — Environment Variables Reference
# ==============================================================================
# This project is split into two packages:
#   1. backend/   (Node.js + Express + MongoDB Atlas + Better Auth + Razorpay + Cloudinary)
#   2. frontend/  (React + Vite + Tailwind CSS)
#
# Please configure your environment variables in their respective directories:
#   - backend/.env    (copy from backend/.env.example)
#   - frontend/.env   (copy from frontend/.env.example)
# ==============================================================================

# --- BACKEND (backend/.env) ---
# PORT=5000
# NODE_ENV=development
# CLIENT_URL=http://localhost:5173
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dreamzdecors?retryWrites=true&w=majority
# BETTER_AUTH_URL=http://localhost:5000
# BETTER_AUTH_SECRET=your-random-secret-key-here
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=your-email@gmail.com
# CONTACT_TO=your-email@gmail.com
# VAPID_PUBLIC_KEY=your-webpush-public-key
# VAPID_PRIVATE_KEY=your-webpush-private-key
# VAPID_SUBJECT=mailto:support@dreamzdecor.com

# --- FRONTEND (frontend/.env) ---
# VITE_API_URL=http://localhost:5000/api
# VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
