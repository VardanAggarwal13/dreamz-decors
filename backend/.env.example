# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/dreamzdecors

# Better Auth (authentication)
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# Google OAuth (for "Continue with Google")
# Redirect URI in Google Console: http://localhost:5000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (paste the keys you'll share with me)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email: Recommended for Render/Cloud hosting (bypasses blocked SMTP ports):
# Resend HTTP API (get a free key from resend.com — 3000 free emails/month):
RESEND_API_KEY=

# Or Email via SMTP (Note: Render/cloud free tiers block ports 25, 465, 587):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The sender for ALL app emails (reset, welcome, order confirmations, etc.):
MAIL_FROM=

# Web-push (VAPID). Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dreamzdecor30@gmail.com
